Window.SetBackgroundTopColor(0.055, 0.065, 0.090);
Window.SetBackgroundBottomColor(0.020, 0.025, 0.040);
logo.image = Image("cloudless-logo.png");
logo.sprite = Sprite(logo.image);
logo.opacity_angle = 0;

fun refresh_callback ()
  {
    logo.opacity_angle += ((2 * 3.14) / 50) * 0.5;
    opacity = 0.72 + 0.20 * Math.Sin(logo.opacity_angle);
    logo.sprite.SetX (Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
    logo.sprite.SetY (Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
    logo.sprite.SetOpacity (opacity);
  }

Plymouth.SetRefreshFunction (refresh_callback);
