#!/bin/sh
set -u

output="${1:-cloudless-diagnostics-$(date -u +%Y%m%dT%H%M%SZ).txt}"
umask 077
exec 3>&1
exec > "$output" 2>&1

section() { printf '\n===== %s =====\n' "$1"; }
run() { echo "\$ $*"; "$@" 2>&1 || true; }

echo "CloudlessOS diagnostics (no application configuration or credentials)"
echo "Generated: $(date -u +%FT%TZ)"
section "Platform"
run uname -a
run dpkg --print-architecture
run sh -c 'test -r /etc/dgx-release && cat /etc/dgx-release || true'
run sh -c 'test -r /sys/devices/virtual/dmi/id/product_name && cat /sys/devices/virtual/dmi/id/product_name || true'
run mokutil --sb-state
section "GPU and containers"
run nvidia-smi
run nvidia-ctk --version
run nvidia-ctk cdi list
run docker info
run docker ps --format '{{.Names}}\t{{.Image}}\t{{.Status}}'
section "Cloudless services"
run systemctl --no-pager --full status cloudlessd cloudless-hardware cloudless-firstboot cloudless-graphical-recovery lightdm docker
run journalctl -b --no-pager -u cloudlessd -u cloudless-hardware -u cloudless-firstboot -u cloudless-graphical-recovery -u lightdm -n 400
run sh -c 'cat /var/lib/cloudless/boot-health.json /var/lib/cloudless/boot-health-history.tsv /var/lib/cloudless/validation-report.txt 2>/dev/null || true'
section "Display and kiosk"
run systemctl get-default
run sh -c 'readlink -f /etc/systemd/system/display-manager.service || true'
run sh -c 'stat -c "%U:%G %a %n" /home/cloudless /home/cloudless/.config /home/cloudless/.cache 2>/dev/null || true'
run sh -c 'ps -u cloudless -o pid,comm,args 2>/dev/null || true'
run sh -c 'tail -n 200 /home/cloudless/.cache/cloudless-kiosk.log 2>/dev/null || true'
run sh -c 'tail -n 160 /var/log/lightdm/lightdm.log /var/log/lightdm/x-0.log 2>/dev/null || true'
section "Cloudless API"
run curl --silent --show-error --max-time 10 http://127.0.0.1:8765/api/health
run curl --silent --show-error --max-time 10 http://127.0.0.1:8765/api/system
run curl --silent --show-error --max-time 10 http://127.0.0.1:8765/api/gpu
section "Storage"
run df -hT

printf 'Diagnostics written to %s\n' "$output" >&3
