[Unit]
Description=Audit the CloudlessOS graphical boot ownership chain
After=cloudlessd.service lightdm.service
Wants=cloudlessd.service lightdm.service
OnFailure=cloudless-graphical-recovery.service

[Service]
Type=oneshot
ExecStart=/usr/lib/cloudless/cloudless-boot-audit
RemainAfterExit=yes
TimeoutStartSec=110
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudless
UMask=0077

[Install]
WantedBy=graphical.target
