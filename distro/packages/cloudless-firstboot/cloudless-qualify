from pathlib import Path

SCHEMA = "cloudless.physical-evidence.v1"
CHECK_SCHEMA = "cloudless.physical-check.v1"
EXPORT_SCHEMA = "cloudless.physical-export.v1"
SET_SCHEMA = "cloudless.physical-set.v1"
SOAK_SCHEMA = "cloudless.physical-soak.v1"
DEFAULT_MATRIX = Path("/usr/share/cloudless/physical-validation-matrix.json")
DEFAULT_UPDATE_STATUS = Path("/var/lib/cloudless-updater/status.json")
DEFAULT_BOOT_HEALTH = Path("/var/lib/cloudless/boot-health.json")
DEFAULT_QUALIFICATION_ROOT = Path("/var/lib/cloudless/qualification")
ACTIVE_SCHEMA = "cloudless.physical-active-campaign.v1"
MAX_EVIDENCE_BYTES = 64 * 1024 * 1024
MAX_EXPORT_BYTES = 2 * 1024 * 1024 * 1024
MAX_SOAK_SAMPLES = 10000
VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+(?:[-+~][0-9A-Za-z][0-9A-Za-z.+~_-]*)?$")
COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
SECRET_PATTERNS = [
    re.compile(pattern, re.IGNORECASE)
    for pattern in (
        r"\bauthorization\s*:",
        r"\bbearer\s+[A-Za-z0-9._~+/=-]{8,}",
        r"\b(?:password|passwd|token|secret|private[_ -]?key)\s*[:=]\s*\S+",
        r"\b(?:github_pat_|gh[pousr]_|cfat_)[A-Za-z0-9_-]{8,}",
        r"\bAKIA[0-9A-Z]{16}\b",
    )
]


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise ValueError(f"file must be a regular non-symlink file: {path}")
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def atomic_json(path: Path, payload: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(name, 0o600)
        os.replace(name, path)
    finally:
        try:
            os.unlink(name)
        except FileNotFoundError:
            pass


def load_json(path: Path) -> dict:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise ValueError(f"{path} must be a regular non-symlink file")
        value = json.loads(handle.read().decode("utf-8"))
    if not isinstance(value, dict):
        raise ValueError(f"{path} does not contain a JSON object")
    return value


def load_matrix(path: Path) -> dict:
    matrix = load_json(path)
    if matrix.get("schema") != "cloudless.physical-validation.v1":
        raise ValueError("unsupported physical qualification matrix")
    ids = [target.get("id") for target in matrix.get("targets", [])]
    if not ids or len(ids) != len(set(ids)):
        raise ValueError("physical qualification target IDs are missing or duplicated")
    for field in ("requiredChecks", "clusterChecks", "clusterFailureDomains", "inferenceLifecyclePhases"):
        values = matrix.get(field, [])
        if not isinstance(values, list) or any(not re.fullmatch(r"[a-z0-9-]+", str(value)) for value in values):
            raise ValueError(f"physical qualification {field} must contain normalized names")
        if len(values) != len(set(values)):
            raise ValueError(f"physical qualification {field} contains duplicates")
    failure_targets = [target for target in matrix.get("targets", []) if target.get("failureMatrix")]
    if failure_targets and (
        not matrix.get("clusterFailureDomains") or not matrix.get("inferenceLifecyclePhases")
    ):
        raise ValueError("failure-matrix targets require failure domains and lifecycle phases")
    return matrix


def target_by_id(matrix: dict, target_id: str) -> dict:
    for target in matrix.get("targets", []):
        if target.get("id") == target_id:
            return target
    raise ValueError(f"unknown qualification target: {target_id}")


def expected_machine_arch(architecture: str) -> set[str]:
    return {"x86_64", "amd64"} if architecture == "amd64" else {"aarch64", "arm64"}


def detect_dgx() -> bool:
    if Path("/etc/dgx-release").is_file():
        return True
    product = Path("/sys/devices/virtual/dmi/id/product_name")
    try:
        return bool(re.search(r"DGX[\s_-]*Spark|GB10", product.read_text(encoding="utf-8"), re.I))
    except OSError:
        return False


def detect_virtualbox() -> bool:
    values = []
    for name in ("product_name", "sys_vendor", "board_vendor"):
        try:
            values.append(Path("/sys/devices/virtual/dmi/id", name).read_text(encoding="utf-8"))
        except OSError:
            pass
    return "virtualbox" in " ".join(values).lower()


def detect_nvidia() -> bool:
    try:
        return subprocess.run(
            ["nvidia-smi"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False
        ).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def verify_target_machine(target: dict, machine_arch: str | None = None, machine_kind: str | None = None) -> None:
    actual_arch = (machine_arch or platform.machine()).lower()
    if actual_arch not in expected_machine_arch(str(target.get("architecture"))):
        raise ValueError(
            f"target expects {target.get('architecture')}, but this machine reports {actual_arch}"
        )
    expected_platform = target.get("platform")
    if machine_kind is None:
        if detect_dgx():
            machine_kind = "dgx-spark"
        elif detect_virtualbox():
            machine_kind = "virtualbox"
        elif detect_nvidia():
            machine_kind = "generic-nvidia"
        else:
            machine_kind = "unsupported"
    if machine_kind != expected_platform:
        raise ValueError(f"target expects {expected_platform}, but this machine is {machine_kind}")


def installed_source_commit(version: str, status_path: Path | None = None) -> str:
    path = status_path or Path(os.environ.get("CLOUDLESS_UPDATE_STATUS", DEFAULT_UPDATE_STATUS))
    try:
        status = load_json(path)
    except FileNotFoundError as exc:
        raise ValueError(
            "source commit was not provided and no verified updater identity is available"
        ) from exc
    if status.get("currentVersion") != version:
        raise ValueError(
            f"updater identity describes {status.get('currentVersion') or 'no installed version'}, "
            f"not {version}"
        )
    commit = str(status.get("currentSourceCommit", "")).strip().lower()
    if not COMMIT_RE.fullmatch(commit):
        raise ValueError("updater state does not contain a verified installed source commit")
    return commit


def begin_campaign(
    matrix_path: Path,
    target_id: str,
    version: str,
    commit: str | None,
    output: Path,
    operator: str,
    *,
    machine_arch: str | None = None,
    machine_kind: str | None = None,
) -> Path:
    matrix = load_matrix(matrix_path)
    target = target_by_id(matrix, target_id)
    version = version.strip()
    commit = commit.strip().lower() if commit else installed_source_commit(version)
    operator = operator.strip()
    if not VERSION_RE.fullmatch(version):
        raise ValueError("version must be a semantic CloudlessOS version")
    if not COMMIT_RE.fullmatch(commit):
        raise ValueError("source commit must be the full 40-character Git commit")
    if not operator or len(operator) > 128:
        raise ValueError("operator name is required and must be at most 128 characters")
    reject_secrets(operator)
    verify_target_machine(target, machine_arch, machine_kind)
    if output.is_symlink():
        raise ValueError("qualification output must not be a symlink")
    if output.exists() and any(output.iterdir()):
        raise ValueError(f"qualification directory is not empty: {output}")
    output.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(output, 0o700)
    payload = {
        "schema": SCHEMA,
        "target": target,
        "version": version,
        "sourceCommit": commit,
        "operator": operator,
        "startedAt": utc_now(),
        "matrixSha256": sha256_file(matrix_path),
        "machine": {
            "architecture": (machine_arch or platform.machine()).lower(),
            "hostnameHash": hashlib.sha256(socket.gethostname().encode()).hexdigest()[:16],
        },
    }
    atomic_json(output / "campaign.json", payload)
    (output / "checks").mkdir(mode=0o700)
    (output / "boots").mkdir(mode=0o700)
    (output / "evidence").mkdir(mode=0o700)
    return output


def qualification_root(path: Path | None = None) -> Path:
    root = path or Path(os.environ.get("CLOUDLESS_QUALIFICATION_ROOT", DEFAULT_QUALIFICATION_ROOT))
    if root.is_symlink():
        raise ValueError("qualification root must not be a symlink")
    root.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(root, 0o700)
    return root.resolve()


def activate_campaign(campaign: Path, root: Path | None = None) -> Path:
    root = qualification_root(root)
    verify_campaign_layout(campaign)
    campaign = campaign.resolve()
    try:
        relative = campaign.relative_to(root)
    except ValueError as exc:
        raise ValueError("automatic boot recording requires a campaign inside the qualification root") from exc
    manifest_path = campaign / "campaign.json"
    manifest = load_json(manifest_path)
    pointer = root / "active-campaign.json"
    atomic_json(
        pointer,
        {
            "schema": ACTIVE_SCHEMA,
            "campaign": relative.as_posix(),
            "campaignSha256": sha256_file(manifest_path),
            "target": manifest.get("target", {}).get("id"),
            "version": manifest.get("version"),
            "sourceCommit": manifest.get("sourceCommit"),
            "activatedAt": utc_now(),
        },
    )
    return pointer


def active_campaign(root: Path | None = None, *, allow_sealed: bool = False) -> tuple[Path, dict]:
    root = qualification_root(root)
    pointer_path = root / "active-campaign.json"
    if pointer_path.is_symlink() or not pointer_path.is_file():
        raise ValueError("no automatic physical qualification campaign is active")
    pointer = load_json(pointer_path)
    if pointer.get("schema") != ACTIVE_SCHEMA:
        raise ValueError("active qualification campaign has an unsupported schema")
    relative = Path(str(pointer.get("campaign", "")))
    if relative.is_absolute() or not relative.parts or ".." in relative.parts:
        raise ValueError("active qualification campaign path is unsafe")
    campaign = root / relative
    verify_campaign_layout(campaign)
    campaign = campaign.resolve()
    try:
        campaign.relative_to(root)
    except ValueError as exc:
        raise ValueError("active qualification campaign escapes the qualification root") from exc
    manifest_path = campaign / "campaign.json"
    manifest = load_json(manifest_path)
    if sha256_file(manifest_path) != pointer.get("campaignSha256"):
        raise ValueError("active qualification campaign identity has changed")
    expected = (
        pointer.get("target"),
        pointer.get("version"),
        pointer.get("sourceCommit"),
    )
    actual = (
        manifest.get("target", {}).get("id"),
        manifest.get("version"),
        manifest.get("sourceCommit"),
    )
    if actual != expected:
        raise ValueError("active qualification pointer does not match its campaign")
    if not allow_sealed and (campaign / "qualification-result.json").exists():
        raise ValueError("active qualification campaign is already sealed")
    return campaign, manifest


def deactivate_campaign(campaign: Path, root: Path | None = None) -> bool:
    root = root or Path(os.environ.get("CLOUDLESS_QUALIFICATION_ROOT", DEFAULT_QUALIFICATION_ROOT))
    if not root.exists():
        return False
    if root.is_symlink() or not root.is_dir():
        raise ValueError("qualification root must be a real directory")
    root = root.resolve()
    pointer = root / "active-campaign.json"
    if not pointer.exists():
        return False
    try:
        active, _ = active_campaign(root, allow_sealed=True)
    except ValueError as exc:
        if "no automatic physical qualification campaign is active" in str(exc):
            return False
        raise
    if active != campaign.resolve():
        return False
    pointer.unlink()
    return True


def record_active_boot(
    root: Path | None = None,
    matrix_path: Path = DEFAULT_MATRIX,
    status_path: Path | None = None,
    boot_health_path: Path | None = None,
    *,
    machine_arch: str | None = None,
    machine_kind: str | None = None,
) -> tuple[Path, bool]:
    campaign, manifest = active_campaign(root)
    matrix = load_matrix(matrix_path)
    target = campaign_target(campaign, matrix)
    if manifest.get("matrixSha256") != sha256_file(matrix_path):
        raise ValueError("active campaign was created from a different qualification matrix")
    verify_target_machine(target, machine_arch, machine_kind)
    installed_commit = installed_source_commit(str(manifest.get("version", "")), status_path)
    if installed_commit != manifest.get("sourceCommit"):
        raise ValueError("installed source commit does not match the active qualification campaign")
    return campaign, record_boot(campaign, boot_health_path=boot_health_path)


def verify_campaign_layout(campaign: Path) -> None:
    if campaign.is_symlink() or not campaign.is_dir():
        raise ValueError("qualification campaign must be a real directory")
    campaign_root = campaign.resolve()
    for name in ("checks", "boots", "evidence"):
        path = campaign / name
        if path.is_symlink() or not path.is_dir():
            raise ValueError(f"qualification {name} path must be a real directory")
        try:
            path.resolve().relative_to(campaign_root)
        except ValueError as exc:
            raise ValueError(f"qualification {name} path escapes the campaign") from exc


def campaign_target(campaign: Path, matrix: dict) -> dict:
    verify_campaign_layout(campaign)
    manifest = load_json(campaign / "campaign.json")
    if manifest.get("schema") != SCHEMA:
        raise ValueError("unsupported qualification evidence schema")
    target = target_by_id(matrix, str(manifest.get("target", {}).get("id", "")))
    if manifest.get("target") != target:
        raise ValueError("campaign target no longer matches the qualification matrix")
    return target


def applicable_checks(matrix: dict, target: dict) -> list[str]:
    checks = list(matrix.get("requiredChecks", []))
    if int(target.get("nodes", 0)) >= 2:
        checks.extend(matrix.get("clusterChecks", []))
    if target.get("failureMatrix"):
        checks.extend(
            f"cluster-failure--{failure}--{phase}"
            for failure in matrix.get("clusterFailureDomains", [])
            for phase in matrix.get("inferenceLifecyclePhases", [])
        )
    return checks


