#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
# Reenable removes the obsolete multi-user.target link created by releases
# whose audit unit also waited for graphical.target, an ordering cycle that
# caused systemd to skip the audit entirely.
systemctl reenable cloudless-firstboot.service >/dev/null 2>&1 || true
systemctl reenable cloudless-qualification-boot.service >/dev/null 2>&1 || true
