#!/bin/bash
set -euo pipefail
MARKER=/var/lib/cloudless/hardware-configured
REPORT=/var/lib/cloudless/hardware-report.txt

is_dgx_spark() {
    local source
    for source in \
        /etc/dgx-release \
        /proc/device-tree/model \
        /sys/firmware/devicetree/base/model \
        /sys/devices/virtual/dmi/id/product_name
    do
        if [ -r "$source" ] && tr '\0' '\n' < "$source" 2>/dev/null | grep -Eqi 'DGX[[:space:]-]*Spark|GB10'; then
            return 0
        fi
    done
    return 1
}

install -d -m 0750 /var/lib/cloudless
if [ -e "$MARKER" ] && [ "${1:-}" != "--force" ]; then exit 0; fi
exec > >(tee -a "$REPORT") 2>&1
echo "CloudlessOS hardware configuration: $(date -u +%FT%TZ)"

# DGX OS owns the tightly coupled driver, CUDA, firmware, and container runtime
# stack on DGX Spark. Replacing any part with Ubuntu's generic recommendation can
# make the appliance unusable, so Cloudless only records and preserves it.
if is_dgx_spark; then
    echo "DGX Spark detected; preserving the NVIDIA-managed DGX OS compute stack"
    systemctl enable docker.service 2>/dev/null || true
    touch "$MARKER"
    echo "Hardware configuration complete (managed by DGX OS)"
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io ubuntu-drivers-common pciutils curl ca-certificates gnupg
systemctl enable docker.service

if lspci -nn | grep -qi NVIDIA; then
    echo "NVIDIA GPU detected; installing Ubuntu's recommended compute driver"
    ubuntu-drivers install --gpgpu || ubuntu-drivers install
    install -m 0755 -d /usr/share/keyrings
    curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor --yes -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
    curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
      | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
      > /etc/apt/sources.list.d/nvidia-container-toolkit.list
    apt-get update
    apt-get install -y nvidia-container-toolkit
    nvidia-ctk runtime configure --runtime=docker
else
    echo "No NVIDIA GPU detected; CloudlessOS will run in limited mode"
fi
systemctl restart docker.service || true
touch "$MARKER"
echo "Hardware configuration complete"
