[Unit]
Description=Configure CloudlessOS GPU and container hardware
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/cloudless/cloudless-hardware-install
RemainAfterExit=yes
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
