[Unit]
Description=Configure CloudlessOS GPU and container hardware
Wants=network-online.target
After=network-online.target
Before=cloudlessd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/cloudless/cloudless-hardware-install
RemainAfterExit=yes
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
