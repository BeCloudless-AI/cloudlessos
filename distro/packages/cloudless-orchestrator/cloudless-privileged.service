[Unit]
Description=CloudlessOS privileged action broker
After=dbus.service
Before=cloudlessd.service

[Service]
Type=simple
ExecStart=/usr/lib/cloudless/cloudless-privileged
Restart=on-failure
RestartSec=2
RuntimeDirectory=cloudless
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
User=root
Group=cloudless-control
UMask=0077
NoNewPrivileges=true
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/netplan /etc/cloudless /etc/apt/sources.list.d -/run/systemd/system -/run/systemd/network -/run/NetworkManager/conf.d -/run/NetworkManager/system-connections /run/udev /var/lib/cloudless/recipes-runtime /var/lib/cloudless/models-cache -/home/cloudless/Cloudless/Models
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
