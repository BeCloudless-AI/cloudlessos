[Unit]
Description=CloudlessOS orchestrator
Requires=cloudless-engine.service
Wants=cloudless-privileged.service
After=network.target cloudless-engine.service cloudless-privileged.service

[Service]
Type=simple
User=cloudlessd
Group=cloudless-control
SupplementaryGroups=cloudless
EnvironmentFile=-/etc/cloudless/cloudless.env
Environment=CLOUDLESS_ENGINE_SOCKET=/run/cloudless/engine.sock
Environment=CLOUDLESS_BUILD_ROOT=/var/lib/cloudless/builds
Environment=CLOUDLESS_MODEL_CACHE=/var/lib/cloudless/models-cache
ExecStart=/usr/lib/cloudless/cloudlessd
Restart=always
RestartSec=3
TimeoutStopSec=15
StateDirectory=cloudless
StateDirectoryMode=0751
CacheDirectory=cloudless
CacheDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudless -/run/cloudless-browser -/home/cloudless/Cloudless -/home/cloudless/Downloads

[Install]
WantedBy=multi-user.target
