[Unit]
Description=CloudlessOS orchestrator
Wants=docker.service
After=network.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/cloudless/cloudless.env
ExecStart=/usr/lib/cloudless/cloudlessd
Restart=always
RestartSec=3
TimeoutStopSec=15
StateDirectory=cloudless
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudless -/run/docker.sock -/home/cloudless/Cloudless -/home/cloudless/Downloads

[Install]
WantedBy=multi-user.target
