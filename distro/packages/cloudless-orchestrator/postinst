#!/bin/sh
set -e
install -d -m 0750 /var/lib/cloudless
getent group cloudless-control >/dev/null || addgroup --system cloudless-control
getent group cloudless >/dev/null || addgroup --system cloudless
if ! getent passwd cloudlessd >/dev/null; then
    adduser --system --no-create-home --home /nonexistent --shell /usr/sbin/nologin --ingroup cloudless-control cloudlessd
fi
adduser cloudlessd cloudless >/dev/null 2>&1 || true
# The desktop follows read-only links from Models into models-cache. Grant
# traversal (not listing) on the state root; each child retains its own strict
# group/mode, and the desktop is never added to cloudless-control.
install -d -m 0751 -o cloudlessd -g cloudless-control /var/lib/cloudless
install -d -m 0750 -o cloudlessd -g cloudless-control /var/lib/cloudless/builds
install -d -m 2750 -o cloudlessd -g cloudless /var/lib/cloudless/models-cache

# Older root-run orchestrators created the read-only Models view as root. Only
# repair directories carrying Cloudless's own revision marker; user-created
# folders and files are never touched. Files are hard links into the cache and
# do not need ownership changes for a safe unlink.
model_view=/home/cloudless/Cloudless/Models
if [ -d "$model_view" ]; then
    for marker in "$model_view"/*/.cloudless-revision; do
        [ -f "$marker" ] || continue
        managed_dir=${marker%/.cloudless-revision}
        find "$managed_dir" -type d -exec chown cloudlessd:cloudless {} + -exec chmod 0755 {} +
    done
fi

# Releases before the unprivileged daemon migration created cluster identity
# and recipe metadata as root. Preserve their contents while transferring only
# Cloudless control-plane paths to the service account that now reads them.
for state_path in cluster recipes recipes-runtime; do
    install -d -m 0700 -o cloudlessd -g cloudless-control "/var/lib/cloudless/$state_path"
    chown -R cloudlessd:cloudless-control "/var/lib/cloudless/$state_path"
done
find /var/lib/cloudless/cluster -type d -exec chmod 0700 {} +
find /var/lib/cloudless/cluster -type f -exec chmod 0600 {} +
if [ -f /var/lib/cloudless/cluster/id_ed25519.pub ]; then
    chmod 0644 /var/lib/cloudless/cluster/id_ed25519.pub
fi
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable cloudless-privileged.service >/dev/null 2>&1 || true
systemctl enable cloudless-engine.service >/dev/null 2>&1 || true
systemctl enable cloudlessd.service >/dev/null 2>&1 || true
# Install the official Tailscale client on the next normal boot, outside dpkg's
# lock. It remains logged out and shares nothing until the user opts in.
systemctl enable cloudless-tailscale-install.service >/dev/null 2>&1 || true

# Remove runtime data left by the retired third-party recipe provider. These
# exact paths were created by earlier CloudlessOS arm64 packages and are not
# dpkg-owned, so an ordinary package upgrade cannot remove them for us.
legacy_provider="spark""run"
systemctl disable --now "cloudless-${legacy_provider}.service" >/dev/null 2>&1 || true
for legacy_path in \
  "/opt/cloudless/${legacy_provider}" \
  "/var/lib/cloudless/${legacy_provider}" \
  "/var/cache/cloudless/${legacy_provider}"
do
  case "$legacy_path" in
    "/opt/cloudless/${legacy_provider}"|"/var/lib/cloudless/${legacy_provider}"|"/var/cache/cloudless/${legacy_provider}")
      rm -rf -- "$legacy_path"
      ;;
  esac
done
rm -f -- \
  "/usr/lib/cloudless/cloudless-${legacy_provider}-install" \
  "/lib/systemd/system/cloudless-${legacy_provider}.service" \
  "/etc/systemd/system/multi-user.target.wants/cloudless-${legacy_provider}.service"
systemctl daemon-reload >/dev/null 2>&1 || true
