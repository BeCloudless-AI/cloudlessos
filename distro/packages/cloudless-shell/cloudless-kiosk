#!/bin/sh
set -u
export HOME="${HOME:-/home/cloudless}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export PATH="/snap/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
mkdir -p "$XDG_CACHE_HOME"
LOG="$XDG_CACHE_HOME/cloudless-kiosk.log"
exec >>"$LOG" 2>&1

echo "$(date -Is) Cloudless kiosk starting"

START_URL=http://127.0.0.1:8765
attempt=0
while ! curl --silent --fail --max-time 2 http://127.0.0.1:8765/api/health >/dev/null; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 25 ]; then
        START_URL=file:///usr/share/cloudless/recovery.html
        echo "$(date -Is) Cloudless API is still unavailable; opening the recovery screen"
        break
    fi
    sleep 1
done
[ "$START_URL" != http://127.0.0.1:8765 ] || echo "$(date -Is) Cloudless API is ready"

# Restore the last display mode selected in CloudlessOS Settings. The API only
# persists modes reported by xrandr for a connected output, and this final
# character check keeps shell arguments constrained even if the state file is
# edited manually.
DISPLAY_MODE="$(
    curl --silent --fail --max-time 3 http://127.0.0.1:8765/api/system/display 2>/dev/null |
    python3 -c 'import json,sys; d=json.load(sys.stdin).get("configured") or {}; o=d.get("output",""); w=int(d.get("width") or 0); h=int(d.get("height") or 0); print(o, f"{w}x{h}" if w and h else "")' 2>/dev/null
)" || DISPLAY_MODE=""
if [ -n "$DISPLAY_MODE" ]; then
    set -- $DISPLAY_MODE
    case "${1:-}:${2:-}" in
        *[!A-Za-z0-9_.:-]*|*:*[!0-9x]*) echo "$(date -Is) ignored invalid saved display mode" ;;
        ?*:[0-9]*x[0-9]*)
            if xrandr --output "$1" --mode "$2"; then
                echo "$(date -Is) restored display mode $1 $2"
            else
                echo "$(date -Is) could not restore display mode $1 $2"
            fi
            ;;
    esac
fi

find_browser() {
    for candidate in chromium chromium-browser google-chrome-stable firefox; do
        if command -v "$candidate" >/dev/null 2>&1; then command -v "$candidate"; return 0; fi
    done
    return 1
}
# Snap mounts can finish after LightDM starts on the first boot. Keep retrying
# instead of leaving users at Openbox's empty black background when Chromium's
# first launch races its core/base snap activation.
while :; do
    if ! BROWSER="$(find_browser)"; then
        echo "$(date -Is) browser command not available yet; retrying"
        sleep 2
        continue
    fi

    echo "$(date -Is) launching $BROWSER"
    case "$(basename "$BROWSER")" in
        firefox)
            # Never share Firefox's everyday profile with the kiosk. A hard
            # graphical-session restart can otherwise restore every old kiosk
            # tab, leaving several Cloudless pages polling and repainting at
            # once. The result looks like Firefox is repeatedly refreshing even
            # though its main process never exits.
            case "$BROWSER" in
                /snap/*|*/snap/*) PROFILE_DIR="$HOME/snap/firefox/common/cloudless-kiosk" ;;
                *) PROFILE_DIR="$XDG_CONFIG_HOME/cloudless-firefox-kiosk" ;;
            esac
            mkdir -p "$PROFILE_DIR/sessionstore-backups"
            cat >"$PROFILE_DIR/user.js" <<'EOF'
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_resumed_crashes", 0);
user_pref("browser.startup.page", 0);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.warnOnQuitShortcut", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
EOF
            # Firefox software rendering was originally forced to make the
            # generic VirtualBox image conservative. On physical NVIDIA hosts
            # that disables HW_COMPOSITING and makes every translucent panel,
            # scroll and transition run on the CPU. Prefer WebRender whenever
            # the NVIDIA driver is live, while retaining the old safe path for
            # VMs and machines without a usable NVIDIA device.
            FIREFOX_HW_ACCEL=0
            if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
                FIREFOX_HW_ACCEL=1
                cat >>"$PROFILE_DIR/user.js" <<'EOF'
user_pref("gfx.canvas.accelerated", true);
user_pref("gfx.webrender.all", true);
user_pref("gfx.webrender.software", false);
user_pref("layers.acceleration.disabled", false);
user_pref("media.hardware-video-decoding.enabled", true);
user_pref("webgl.disabled", false);
EOF
                echo "$(date -Is) NVIDIA graphics available; enabling Firefox hardware composition"
            else
                cat >>"$PROFILE_DIR/user.js" <<'EOF'
user_pref("gfx.canvas.accelerated", false);
user_pref("gfx.webrender.all", false);
user_pref("gfx.webrender.software", true);
user_pref("layers.acceleration.disabled", true);
user_pref("media.hardware-video-decoding.enabled", false);
user_pref("webgl.disabled", true);
EOF
                echo "$(date -Is) no usable NVIDIA graphics detected; using Firefox software rendering"
            fi
            rm -f "$PROFILE_DIR/sessionstore.jsonlz4" \
                "$PROFILE_DIR"/sessionstore-backups/*
            if [ "$FIREFOX_HW_ACCEL" -eq 1 ]; then
                MOZ_WEBRENDER=1 "$BROWSER" --no-remote --profile "$PROFILE_DIR" \
                    --class CloudlessKiosk --kiosk "$START_URL"
            else
                LIBGL_ALWAYS_SOFTWARE=1 MOZ_WEBRENDER=0 \
                    "$BROWSER" --no-remote --profile "$PROFILE_DIR" \
                    --class CloudlessKiosk --kiosk "$START_URL"
            fi
            ;;
        *)
            # Strictly confined Chromium snaps cannot write arbitrary hidden
            # paths such as ~/.config. Their own ~/snap/<name>/common tree is
            # writable and persists across snap revisions. Native browsers keep
            # using the standard XDG configuration directory.
            case "$BROWSER" in
                /snap/*|*/snap/*) PROFILE_DIR="$HOME/snap/chromium/common/cloudless-browser" ;;
                *) PROFILE_DIR="$XDG_CONFIG_HOME/cloudless-browser" ;;
            esac
            mkdir -p "$PROFILE_DIR"
            "$BROWSER" --class=CloudlessKiosk --kiosk --app="$START_URL" \
                --user-data-dir="$PROFILE_DIR" --no-first-run \
                --disable-session-crashed-bubble --disable-infobars --disable-pinch \
                --overscroll-history-navigation=0
            ;;
    esac
    status=$?
    echo "$(date -Is) browser exited with status $status; retrying in 3 seconds"
    sleep 3
done
