[Unit]
Description=Install the recommended NVIDIA driver update
Wants=network-online.target
After=network-online.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/cloudless/cloudless-updater nvidia-apply
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
