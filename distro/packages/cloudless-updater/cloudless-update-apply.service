[Unit]
Description=Install verified CloudlessOS updates
Wants=network-online.target
After=network-online.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/cloudless/cloudless-updater apply
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
