[Unit]
Description=Check for CloudlessOS updates
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/cloudless/cloudless-updater check
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
