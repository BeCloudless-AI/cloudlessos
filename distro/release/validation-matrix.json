    "package-lifecycle",
    "release-isolation",
    "release-preflight",
    "secret-hygiene",
    "service-hardening",
    "sbom",
    "trust-inventory",
    "vulnerability-scan",
    "updater-workload-continuity",
    "atomic-repository"
