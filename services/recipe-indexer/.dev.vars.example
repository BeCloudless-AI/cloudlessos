ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:8787
AUTOPUBLISH_DISCOVERED=true
GITHUB_TOKEN=github-app-installation-token
ADMIN_TOKEN=replace-with-a-long-random-value
