{
  "name": "@cloudless/recipe-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudless recipe discovery, validation, signing, and catalog API",
  "scripts": {
    "test": "node --test",
    "check": "wrangler deploy --dry-run --outdir dist/worker",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:cloudflare": "bash scripts/deploy-indexer.sh",
    "keys:generate": "node scripts/generate-signing-key.mjs",
    "db:migrate:local": "wrangler d1 migrations apply RECIPE_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply RECIPE_DB --remote"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22"
  }
}
