{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudless-recipe-indexer",
	"main": "src/index.js",
	"compatibility_date": "2026-07-28",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "recipes.becloudless.ai",
			"custom_domain": true
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"PUBLIC_BASE_URL": "https://recipes.becloudless.ai",
		"CATALOG_KEY_ID": "cloudless-recipes-2026-07",
		"GITHUB_API_VERSION": "2022-11-28",
		"AUTOPUBLISH_DISCOVERED": "true"
	},
	"d1_databases": [
		{
			"binding": "RECIPE_DB",
			"database_name": "cloudless-recipes",
			"database_id": "4f9febe4-2c69-40e1-a9e2-a207fd133de4",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "RECIPE_BUCKET",
			"bucket_name": "cloudless-recipes"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "RECIPE_JOBS",
				"queue": "cloudless-recipe-indexer"
			}
		],
		"consumers": [
			{
				"queue": "cloudless-recipe-indexer",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "cloudless-recipe-indexer-dead"
			}
		]
	},
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
